# ===========================================================================
# HeatShield Bharat — Frontend Environment Variables (Vite)
# ===========================================================================
# Copy this file to .env and adjust for your local setup.
#
# Vite exposes variables prefixed with VITE_ to client-side code.
# NEVER place secrets here — all VITE_ variables are embedded in the bundle.
# ===========================================================================

# Backend API base URL (development default pointing to FastAPI backend)
VITE_API_BASE_URL=http://localhost:8000/api/v1
