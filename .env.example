# ===========================================================================
# HeatShield Bharat — Root Environment Variables
# ===========================================================================
# Copy this file to .env and fill in your local values.
# NEVER commit the .env file — it may contain secrets.
# ===========================================================================

# General
APP_ENV=development

# PostgreSQL (used by backend — install PostgreSQL when ready)
POSTGRES_USER=heatshield_dev
POSTGRES_PASSWORD=change_me_before_use
POSTGRES_DB=heatshield_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
