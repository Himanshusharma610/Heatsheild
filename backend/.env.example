# ===========================================================================
# HeatShield Bharat — Backend Environment Variables
# ===========================================================================
# Copy this file to .env and fill in your local values.
# NEVER commit the .env file — it may contain secrets.
# ===========================================================================

# Application Metadata
APP_NAME=HeatShield Bharat API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# API Routing Prefix
API_PREFIX=/api/v1

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Security (Cryptographic signing key — must be overridden in production)
SECRET_KEY=dev-insecure-secret-key-change-in-production

# CORS — allowed origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL 15+) — Module 4
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://heatshield_dev:change_me_before_use@localhost:5432/heatshield_dev

# Database Connection Pool Configuration
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
