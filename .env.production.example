# ==============================================================================
# HeatShield Bharat — Production Environment Variables Template
# ==============================================================================
# Copy this file to .env.production on your deployment host.
# NEVER commit production .env files containing real secrets to version control.
# ==============================================================================

# Application Environment (enforces strict startup validation)
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Web Server Public Port
PORT=80

# PostgreSQL Persistence
POSTGRES_USER=heatshield_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_GENERATED_DB_PASSWORD_32_CHARS
POSTGRES_DB=heatshield_production

# JWT Authentication & Cryptographic Signing Key (Module 12)
# MUST be generated using a cryptographically secure RNG (minimum 32 characters):
# e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_TOKEN_MINIMUM_32_CHARS

# CORS Whitelist (Comma-separated list of allowed origins)
CORS_ORIGINS=https://heatshield.gov.in,https://dashboard.heatshield.gov.in

# Backend ASGI Concurrency
BACKEND_WORKERS=2
